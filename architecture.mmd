flowchart LR

%% ---------- Styles ----------
classDef source fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#0f172a
classDef feature fill:#ffffff,stroke:#1e293b,stroke-width:1.8px,color:#0f172a
classDef model fill:#1e293b,stroke:#0f172a,stroke-width:2px,color:#ffffff
classDef output fill:#fff7ed,stroke:#fb923c,stroke-width:1.5px,color:#431407
classDef api fill:#eff6ff,stroke:#2563eb,stroke-width:1.2px,color:#1e3a8a

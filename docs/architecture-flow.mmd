flowchart TB
    subgraph STAGE1["STAGE 1 · DATA INGESTION LAYER"]
        CAMS["CAMS Forecast<br/>Copernicus API<br/>regional AQI · PM2.5/PM10/O3/NOx<br/>4–5 day lead"]
        OBS["CPCB Observations<br/>station AQI<br/>PM2.5/PM10/O3/NOx"]
        MET["Meteorology<br/>Open-Meteo / OpenWeatherMap<br/>temp · wind · humidity · PBL proxy"]
        FIRE["Fire Hotspots<br/>NASA FIRMS (VIIRS/MODIS)<br/>stubble locations + FRP"]
    end

    subgraph STAGE2["STAGE 2 · FEATURE ENGINEERING PIPELINE"]
        ALIGN["Align CAMS grid → Delhi stations"]
        LAG["Lag features<br/>obs at −6 / −12 / −24 h"]
        DERIVE["Derive physics proxies<br/>inversion strength · ventilation<br/>coeff · fire count/distance"]
        MATRIX["Build feature matrix<br/>[CAMS + met + fire + lags]<br/>per station · per pollutant"]
        ALIGN --> LAG
        LAG --> DERIVE
        DERIVE --> MATRIX
    end

    subgraph STAGE3["STAGE 3 · ML-HYBRID CORRECTION ENGINE"]
        direction TB
        TRAIN["TRAIN (offline)<br/>XGBoost / LSTM<br/>per station · pollutant · lead time<br/>target = observed CPCB"]
        INFER["INFER (live)<br/>bias-correct CAMS forecast<br/>using current features"]
        UNCERT["Uncertainty<br/>quantile regression / ensemble<br/>10–90% confidence bands"]
        TRAIN --> INFER
        INFER --> UNCERT
    end

    subgraph STAGE4["STAGE 4 · POST-PROCESSING & METRICS"]
        AQI["Compute AQI<br/>Indian formula"]
        INVS["Inversion strength<br/>vertical ΔT"]
        VENT["Ventilation coefficient<br/>PBL × wind"]
        PLUME["Stubble plume trajectory<br/>(wind-driven) + source attribution"]
        VERIF["Verification<br/>forecast vs observed<br/>RMSE/MAE per lead time"]
        AQI --> VERIF
        INVS --> VERIF
        VENT --> VERIF
        PLUME --> VERIF
    end

    subgraph STAGE5["STAGE 5 · BACKEND & DATA SERVICES"]
        API["FastAPI (REST) + WebSocket"]
        SCHED["Job Scheduler<br/>Airflow / Celery"]
        DB[("Storage<br/>SQLite → PostGIS")]
        CACHE[("Redis cache")]
        NOTIF["Notification service<br/>(AQI alerts)"]
        AUTH["Auth"]
        API --> DB
        API --> CACHE
        API --> AUTH
        API --> NOTIF
    end

    subgraph STAGE6["STAGE 6 · REAL-TIME DASHBOARD"]
        TRACE["72-h AQI traces<br/>with uncertainty bands"]
        MAP["React + Leaflet maps<br/>PM2.5 / O3 contours"]
        GAUGE["Inversion-strength gauge<br/>ventilation panel"]
        PLUMEVIS["Plume trajectory animation"]
        COMPARE["CAMS vs corrected display"]
        ALERT["AQI health advisories<br/>& alerts"]
        TRACE --> COMPARE
        MAP --> COMPARE
        GAUGE --> COMPARE
        PLUMEVIS --> COMPARE
    end

    %% Stage 1 → Stage 2
    CAMS --> ALIGN
    OBS --> LAG
    MET --> DERIVE
    FIRE --> DERIVE

    %% Stage 2 → Stage 3
    MATRIX --> TRAIN
    MATRIX --> INFER

    %% Stage 3 → Stage 4
    INFER --> AQI
    UNCERT --> AQI
    INFER --> INVS
    INFER --> VENT
    FIRE --> PLUME
    OBS --> VERIF

    %% Stage 4 → Stage 5
    VERIF --> API
    AQI --> API
    SCHED --> API

    %% Stage 5 → Stage 6
    API --> TRACE
    API --> MAP
    API --> GAUGE
    API --> PLUMEVIS
    NOTIF --> ALERT

    %% Future upgrade path
    subgraph FUTURE["FUTURE UPGRADE (Phase 6)"]
        WRFC["WRF-Chem engine<br/>replaces CAMS as physics source<br/>same architecture / dashboard / DB / ML"]
    end
    CAMS -.→ WRFC
